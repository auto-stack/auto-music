name: "music-player"
version: "2.0.0"
description: "AutoMusic Player - Modern Local & Stream Music Player (QQ Music / NetEase / Spotify / Soda Music style)"

scene: "ui"
render: "vue"
api: "rust"
front_port: 17830
back_port: 17831
media_root: ""
icon: "music"
title: "AutoMusic Player"
title_zh: "极光音乐播放器"
category: "media"
desktop: "true"
theme: "dark"
accent: "emerald"

dep stylekit {
    path: "vendor/stylekit"
}
